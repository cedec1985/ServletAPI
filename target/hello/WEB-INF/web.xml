<?xml version="1.0" encoding="UTF-8"?>
<web-app version="3.1" xmlns="http://xmlns.jcp.org/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd">
    <display-name>hello</display-name>

    <welcome-file-list>
        <welcome-file>time.html</welcome-file>
    </welcome-file-list>
    <!-- la déclaration de la servlet -->
    <servlet>
        <servlet-name>Time</servlet-name>
        <!-- le nom de la classe implémentant la servlet (précédé du nom du package) -->
        <servlet-class>servlet.Time</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>Barcode</servlet-name>
        <servlet-class>org.krysalis.barcode4j.servlet.BarcodeServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>QRCode</servlet-name>
        <servlet-class>org.krysalis.barcode4j.servlet.BarcodeServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ArticleServlet</servlet-name>
        <servlet-class>Servlet.ArticleServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>FindArticleServlet</servlet-name>
        <servlet-class>Product.FindArticleServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>PdfExportServlet</servlet-name>
        <servlet-class>Servlet.PdfExportServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>GenerateBarcode</servlet-name>
        <servlet-class>Servlet.GenerateBarcode</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>PurchaseOrder</servlet-name>
        <servlet-class>Servlet.PurchaseOrder</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>Time</servlet-name>
        <url-pattern>/Time</url-pattern>
    </servlet-mapping>
    <!-- l'association de la servlet avec un motif d'URL -->
    <servlet-mapping>
        <servlet-name>QRCode</servlet-name>
        <url-pattern>/QRCode</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>PdfExportServlet</servlet-name>
        <url-pattern>/PdfExportServlet</url-pattern>
    </servlet-mapping>
     <servlet-mapping>
        <servlet-name>GenerateBarcode</servlet-name>
        <url-pattern>/GenerateBarcode</url-pattern>
    </servlet-mapping>
     <servlet-mapping>
        <servlet-name>ArticleServlet</servlet-name>
        <url-pattern>/ArticleServlet</url-pattern>
    </servlet-mapping>
     <servlet-mapping>
        <servlet-name>FindArticleServlet</servlet-name>
        <url-pattern>/FindArticle</url-pattern>
    </servlet-mapping>
    
<resource-ref>
  <description>Connexion DB MySQL</description>
  <res-ref-name>jdbc/MariaDB</res-ref-name>
  <res-type>javax.sql.DataSource</res-type>
  <res-auth>Container</res-auth>
</resource-ref>

</web-app>
